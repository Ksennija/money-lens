{
  "name": "money-lens",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,green \"pnpm --filter frontend dev\" \"pnpm --filter backend dev\"",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter frontend build && pnpm --filter backend build",
    "test": "pnpm -r test",
    "check:deps": "depcruise frontend/src backend/src --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "dependency-cruiser": "^18.6.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}