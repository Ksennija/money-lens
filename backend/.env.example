DATABASE_URL="postgresql://user:password@localhost:5432/money_lens"

# Secret used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Optional. Set when the app runs behind a reverse proxy, so client IPs (used for rate limiting)
# and secure cookies work: "true", the number of proxy hops (e.g. 1), or a subnet. Unset = off.
# TRUST_PROXY=1

# Optional. Maximum database connections shared by sessions and Prisma (default 10).
# DB_POOL_MAX=10
